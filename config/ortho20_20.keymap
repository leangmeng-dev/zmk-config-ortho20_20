#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define LOWER 1
#define RAISE 2

/ {
    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <40 43>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";

            bindings = <
                &kp ESC &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                &kp LSHFT &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp DEL
                &kp TAB &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp UP &kp FSLH
                &kp LCTRL &kp LGUI &kp LALT &kp RGUI &mo LOWER &kp SPACE &kp RET &mo RAISE &kp RGUI &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        lower_layer {
            display-name = "Dev";

            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &bt BT_CLR_ALL &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans &trans &trans &trans &trans &trans &trans &trans
                &kp C_PREV &kp C_PP &kp C_NEXT &trans &trans &trans &trans &trans &trans &trans &kp PG_UP &trans
                &trans &trans &trans &trans &trans &out OUT_TOG &kp RET &trans &trans &kp HOME &kp PG_DN &kp END
            >;
        };

        raise_layer {
            display-name = "Symbols";

            bindings = <
                &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &kp LBKT &kp RBKT
                &trans &trans &trans &trans &trans &trans &kp MINUS &kp EQUAL &kp LBRC &kp RBRC &kp BSLH &kp DEL
                &trans &trans &trans &trans &trans &trans &kp UNDER &kp PLUS &kp PIPE &kp TILDE &kp PG_UP &trans
                &trans &trans &trans &trans &trans &kp RET &kp RET &trans &trans &kp HOME &kp PG_DN &kp END
            >;
        };
    };
};